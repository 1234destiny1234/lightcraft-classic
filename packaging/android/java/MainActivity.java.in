// The Android app's activity: a NativeActivity running the app's native library (libapp.so,
// apps/android), plus what only Java can do for it (crates/android-host calls these methods):
// the system pickers (Storage Access Framework), opening links, and the on-screen keyboard.
//
// Picked documents are copied into the app's own folders, so the native side only ever sees file
// paths; a folder or file on the device's own storage the app may read ("All files access") is
// answered with its real path instead, and copies are reused when the same document is picked
// again (see the Storage section). For a save, the native side gets a path in the cache to write; a FileObserver copies the
// file to the document the user chose once it has been written (the app writes atomically: a
// temporary file renamed into place, so both "closed after writing" and "moved in" count).
//
// Every answer goes back through nativePicked (registered by the native side at start-up). Errors
// never escape: a failed copy is logged and left out of the answer.
package {{android_package}};

import android.app.NativeActivity;
import android.content.ClipData;
import android.content.ClipDescription;
import android.content.ContentResolver;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.pm.PackageManager;
import android.database.Cursor;
import android.net.Uri;
import android.net.wifi.WifiManager;
import android.os.Bundle;
import android.os.Environment;
import android.os.FileObserver;
import android.provider.DocumentsContract;
import android.provider.OpenableColumns;
import android.provider.Settings;
import android.text.InputType;
import android.util.Log;
import android.view.DragAndDropPermissions;
import android.view.DragEvent;
import android.view.KeyEvent;
import android.view.View;
import android.view.inputmethod.BaseInputConnection;
import android.view.inputmethod.EditorInfo;
import android.view.inputmethod.InputConnection;
import android.view.inputmethod.InputMethodManager;
import android.widget.FrameLayout;
import android.widget.Toast;
import android.view.Window;
import android.view.WindowInsets;
import android.view.WindowInsetsController;
import android.view.WindowManager;
import android.webkit.MimeTypeMap;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.concurrent.atomic.AtomicLong;

public class MainActivity extends NativeActivity {
    private static final String TAG = "{{binary}}";
    private static final int FILES = 0, FILE = 1, FOLDER = 2, SAVE = 3;
    /** Folders deeper than this inside a picked folder are not copied. */
    private static final int MAX_DEPTH = 8;

    /** First picker request code; a request code is FIRST_REQUEST + 4·n + kind, so a result that
     *  reaches a new activity (the process was killed while the picker was up) still says its kind. */
    private static final int FIRST_REQUEST = 1000;

    /** Answers a picker (registered by crates/android-host). `paths` null = the pick failed (the
     *  reason is in logcat); `id` ≤ 0 = an answer no native request is waiting for, of kind -id-1. */
    private native void nativePicked(long id, String[] paths);

    private static final class Pending {
        final long id;
        final int kind;
        final String fileName;

        Pending(long id, int kind, String fileName) {
            this.id = id;
            this.kind = kind;
            this.fileName = fileName;
        }
    }

    private final Map<Integer, Pending> pending = new HashMap<>();
    private final List<FileObserver> saves = new ArrayList<>();
    private int nextRequest = 0;
    /** Set once the native side has registered nativePicked; answers before that wait here. */
    private boolean nativeReady;
    private final List<Object[]> held = new ArrayList<>();
    /** Peer sync discovers devices over mDNS: Wi-Fi drops multicast packets without this lock. */
    private WifiManager.MulticastLock multicast;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        hideSystemBars();
        addKeyboardView();
        try {
            WifiManager wifi = (WifiManager) getApplicationContext().getSystemService(WIFI_SERVICE);
            if (wifi != null) {
                multicast = wifi.createMulticastLock(TAG + "-mdns");
                multicast.setReferenceCounted(false);
                multicast.acquire();
            }
        } catch (RuntimeException e) {
            Log.w(TAG, "no multicast lock: " + e);
        }
        startReceiving(getIntent());
        askAllFilesAccessOnce();
    }

    @Override
    protected void onDestroy() {
        if (multicast != null && multicast.isHeld()) multicast.release();
        super.onDestroy();
    }

    @Override
    public void onWindowFocusChanged(boolean hasFocus) {
        super.onWindowFocusChanged(hasFocus);
        if (hasFocus) hideSystemBars();
    }

    /** The app draws its own menu bar at the top: the status bar would sit over it, so it is hidden
     *  (a swipe from the edge shows it for a moment). The navigation bar stays. */
    private void hideSystemBars() {
        Window w = getWindow();
        if (android.os.Build.VERSION.SDK_INT >= 30) {
            WindowInsetsController c = w.getInsetsController();
            if (c != null) {
                c.hide(WindowInsets.Type.statusBars());
                c.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
            }
        } else {
            w.addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
        }
    }

    /** Shows a picker; the answer comes through nativePicked(id, …). */
    public void startPick(final long id, final int kind, final String[] mimes, final String fileName) {
        runOnUiThread(() -> {
            Intent intent;
            switch (kind) {
                case FOLDER:
                    intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
                    break;
                case SAVE:
                    intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
                    intent.addCategory(Intent.CATEGORY_OPENABLE);
                    intent.setType(mimes != null && mimes.length > 0 ? mimes[0] : "application/octet-stream");
                    if (fileName != null) intent.putExtra(Intent.EXTRA_TITLE, fileName);
                    break;
                default:
                    intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
                    intent.addCategory(Intent.CATEGORY_OPENABLE);
                    intent.setType("*/*");
                    if (mimes != null && mimes.length > 0) intent.putExtra(Intent.EXTRA_MIME_TYPES, mimes);
                    intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, kind == FILES);
                    break;
            }
            int request = FIRST_REQUEST + 4 * (nextRequest++ % 100000) + kind;
            pending.put(request, new Pending(id, kind, fileName));
            try {
                startActivityForResult(intent, request);
            } catch (Exception e) {
                Log.e(TAG, "no picker: " + e);
                pending.remove(request);
                answer(id, null);
            }
        });
    }

    @Override
    protected void onActivityResult(int request, int result, Intent data) {
        super.onActivityResult(request, result, data);
        Pending found = pending.remove(request);
        if (found == null) {
            if (request < FIRST_REQUEST) return;
            // the process was killed while the picker was up (the system reclaims memory from apps
            // in the background): this is a new activity, and the request died with the old one.
            // Answer anyway, so the native side can finish the pick or say why it can't.
            int kind = (request - FIRST_REQUEST) % 4;
            Log.w(TAG, "picker answer for a request this activity didn't make (kind " + kind + "): the app was restarted while the picker was up");
            if (kind == SAVE) return;
            found = new Pending(-(kind + 1), kind, null);
        }
        final Pending p = found;
        if (result != RESULT_OK || data == null) {
            answer(p.id, new String[0]);
            return;
        }
        // copies can take a while (a folder of raws): off the UI thread
        new Thread(() -> {
            String[] paths;
            try {
                paths = collect(p, data);
            } catch (Exception e) {
                Log.e(TAG, "picker: " + e);
                paths = null;
            }
            answer(p.id, paths);
        }, "picker").start();
    }

    private String[] collect(Pending p, Intent data) throws IOException {
        List<String> out = new ArrayList<>();
        switch (p.kind) {
            case FOLDER: {
                Uri tree = data.getData();
                if (tree == null) break;
                String docId = DocumentsContract.getTreeDocumentId(tree);
                File real = readableInPlace(tree.getAuthority(), docId, true);
                if (real != null) {
                    out.add(real.getAbsolutePath());
                    break;
                }
                File dest = stagedFolder(tree, docId);
                try (CopyJob job = new CopyJob()) {
                    copyTree(tree, docId, dest, 0, job);
                }
                out.add(dest.getAbsolutePath());
                break;
            }
            case SAVE: {
                Uri target = data.getData();
                if (target == null) break;
                out.add(watchSave(target, safeName(p.fileName, "export")).getAbsolutePath());
                break;
            }
            default: {
                List<Uri> uris = new ArrayList<>();
                ClipData clip = data.getClipData();
                if (clip != null) {
                    for (int i = 0; i < clip.getItemCount(); i++) uris.add(clip.getItemAt(i).getUri());
                } else if (data.getData() != null) {
                    uris.add(data.getData());
                }
                try (CopyJob job = new CopyJob()) {
                    job.total = uris.size();
                    for (Uri uri : uris) {
                        if (job.cancelled) break;
                        try {
                            out.add(stagedFile(uri, job).getAbsolutePath());
                        } catch (IOException | RuntimeException e) {
                            Log.e(TAG, "copy " + uri + ": " + e);
                        }
                    }
                }
                Log.i(TAG, "picker: answered " + out.size() + " of " + uris.size() + " documents");
                if (!uris.isEmpty() && out.isEmpty()) throw new IOException("none of the " + uris.size() + " chosen documents could be copied");
            }
        }
        return out.toArray(new String[0]);
    }

    private void answer(long id, String[] paths) {
        synchronized (held) {
            if (!nativeReady) {
                // after a restart the result can come before the native side is up
                held.add(new Object[]{id, paths});
                return;
            }
        }
        try {
            nativePicked(id, paths);
        } catch (Throwable t) {
            Log.e(TAG, "nativePicked: " + t);
        }
    }

    /** Called by the native side once nativePicked and nativeOpened are registered: delivers what waited. */
    public void hostReady() {
        List<Object[]> waiting;
        synchronized (held) {
            nativeReady = true;
            waiting = new ArrayList<>(held);
            held.clear();
        }
        for (Object[] a : waiting) answer((Long) a[0], (String[]) a[1]);
        openedReady();
    }

    /** Where picked documents are copied: the external files folder, beside the library. */
    private File incoming() {
        File base = getExternalFilesDir(null);
        if (base == null) base = getFilesDir();
        return new File(base, "Incoming");
    }

    /** Copies the folder `parentId` of `tree` into `dest`, which may hold an earlier copy: files of
     *  the same name and size are kept, so picking the same folder again copies only what changed. */
    private void copyTree(Uri tree, String parentId, File dest, int depth, CopyJob job) throws IOException {
        if (depth > MAX_DEPTH || job.cancelled) return;
        Uri children = DocumentsContract.buildChildDocumentsUriUsingTree(tree, parentId);
        String[] cols = {DocumentsContract.Document.COLUMN_DOCUMENT_ID, DocumentsContract.Document.COLUMN_DISPLAY_NAME, DocumentsContract.Document.COLUMN_MIME_TYPE, DocumentsContract.Document.COLUMN_SIZE};
        try (Cursor c = getContentResolver().query(children, cols, null, null, null)) {
            if (c == null) return;
            while (c.moveToNext() && !job.cancelled) {
                String id = c.getString(0);
                String mime = c.getString(2);
                if (DocumentsContract.Document.MIME_TYPE_DIR.equals(mime)) {
                    File sub = new File(dest, safeName(c.getString(1), "item"));
                    if (sub.mkdirs() || sub.isDirectory()) copyTree(tree, id, sub, depth + 1, job);
                } else {
                    String name = withExtension(safeName(c.getString(1), "item"), mime);
                    long size = c.isNull(3) ? -1 : c.getLong(3);
                    File f = new File(dest, name);
                    if (size >= 0 && f.isFile() && f.length() == size) continue;
                    try {
                        job.step(name);
                        copy(DocumentsContract.buildDocumentUriUsingTree(tree, id), f, job);
                    } catch (IOException e) {
                        Log.w(TAG, "copy " + name + ": " + e);
                    }
                }
            }
        }
    }

    /** A path in the cache to write; copied to `target` once the file has been written. */
    private File watchSave(final Uri target, String name) throws IOException {
        final File dir = unique(new File(getCacheDir(), "outgoing"), "save");
        if (!dir.mkdirs() && !dir.isDirectory()) throw new IOException("can't create " + dir);
        final File file = new File(dir, name);
        final String fileName = file.getName();
        final FileObserver[] holder = new FileObserver[1];
        holder[0] = new FileObserver(dir, FileObserver.CLOSE_WRITE | FileObserver.MOVED_TO) {
            @Override
            public void onEvent(int event, String path) {
                if (!fileName.equals(path)) return;
                try (InputStream in = new FileInputStream(file); OutputStream out = getContentResolver().openOutputStream(target, "wt")) {
                    if (out == null) throw new IOException("the document can't be written");
                    pipe(in, out);
                } catch (IOException e) {
                    Log.w(TAG, "save to " + target + ": " + e);
                } finally {
                    stopWatching();
                    synchronized (saves) {
                        saves.remove(holder[0]);
                    }
                    file.delete();
                    dir.delete();
                }
            }
        };
        synchronized (saves) {
            saves.add(holder[0]);
        }
        holder[0].startWatching();
        return file;
    }

    private void copy(Uri uri, File dest, CopyJob job) throws IOException {
        ContentResolver r = getContentResolver();
        try (InputStream in = r.openInputStream(uri); OutputStream out = new FileOutputStream(dest)) {
            if (in == null) throw new IOException("the document can't be read");
            byte[] buf = new byte[1 << 16];
            int n;
            long since = 0;
            while ((n = in.read(buf)) > 0) {
                out.write(buf, 0, n);
                since += n;
                // a large file from a slow provider: ask about cancelling every few MB too
                if (since >= (8 << 20)) {
                    since = 0;
                    if (job.poll()) throw new IOException("cancelled");
                }
            }
        } catch (IOException e) {
            dest.delete();
            throw e;
        }
    }

    private static void pipe(InputStream in, OutputStream out) throws IOException {
        byte[] buf = new byte[1 << 16];
        int n;
        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
    }

    private String displayName(Uri uri) {
        try (Cursor c = getContentResolver().query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
            if (c != null && c.moveToFirst()) return c.getString(0);
        } catch (Exception e) {
            Log.w(TAG, "name of " + uri + ": " + e);
        }
        return uri.getLastPathSegment();
    }

    /** A file name without path separators or control characters, never empty. */
    private static String safeName(String name, String fallback) {
        if (name == null) return fallback;
        String s = name.replaceAll("[/\\\\\\u0000-\\u001f]", "_").trim();
        if (s.isEmpty() || s.equals(".") || s.equals("..")) return fallback;
        return s.length() > 200 ? s.substring(0, 200) : s;
    }

    /** `dir/name`, or `dir/name (2)` … when that exists. */
    private static File unique(File dir, String name) {
        File f = new File(dir, name);
        if (!f.exists()) return f;
        int dot = name.lastIndexOf('.');
        String stem = dot > 0 ? name.substring(0, dot) : name;
        String ext = dot > 0 ? name.substring(dot) : "";
        for (int i = 2; i < 10000; i++) {
            f = new File(dir, stem + " (" + i + ")" + ext);
            if (!f.exists()) return f;
        }
        return new File(dir, stem + " " + System.nanoTime() + ext);
    }

    // ---- Storage (AND.5): reading in place, stable staged copies, copy progress, "All files access"

    /** A copy's progress (registered by crates/android-host); answers whether to stop. */
    private native boolean nativeCopyProgress(long task, long done, long total, String detail);

    /** A copy is over (registered by crates/android-host). */
    private native void nativeCopyEnded(long task);

    private static final AtomicLong nextCopy = new AtomicLong(1);
    private static final String STORAGE_PREFS = "storage";
    private static final String ASKED_ALL_FILES = "askedAllFiles";
    private static final int ASK_STORAGE = 77;

    /** One picker answer's copies, in the activity stack from the first file really copied
     *  (reused copies show nothing). Reports at most every 200 ms between files; `cancelled` once
     *  the row's close button was pressed. */
    private final class CopyJob implements AutoCloseable {
        final long task = nextCopy.getAndIncrement();
        long done, total, lastReport;
        String detail = "";
        boolean cancelled, started;

        /** About to copy `name`. */
        void step(String name) throws IOException {
            done++;
            detail = name;
            started = true;
            report(true);
            if (cancelled) throw new IOException("cancelled");
        }

        /** Whether to stop (asks native code at most every 200 ms). */
        boolean poll() {
            report(false);
            return cancelled;
        }

        private void report(boolean force) {
            if (!started) return;
            long now = System.currentTimeMillis();
            if (!force && now - lastReport < 200) return;
            lastReport = now;
            try {
                if (nativeCopyProgress(task, Math.max(0, done - 1), total, detail)) cancelled = true;
            } catch (Throwable t) {
                Log.w(TAG, "nativeCopyProgress: " + t);
            }
        }

        @Override
        public void close() {
            if (!started) return;
            try {
                nativeCopyEnded(task);
            } catch (Throwable t) {
                Log.w(TAG, "nativeCopyEnded: " + t);
            }
        }
    }

    private SharedPreferences storagePrefs() {
        return getSharedPreferences(STORAGE_PREFS, MODE_PRIVATE);
    }

    /** A document or tree on the device's own storage (the external storage provider's
     *  `primary:<path>`), as a real path the app can read; null otherwise. */
    private File readableInPlace(String authority, String docId, boolean folder) {
        if (!"com.android.externalstorage.documents".equals(authority) || docId == null) return null;
        int colon = docId.indexOf(':');
        if (colon < 0 || !"primary".equals(docId.substring(0, colon))) return null;
        String rel = docId.substring(colon + 1);
        if (rel.contains("..")) return null;
        try {
            File base = Environment.getExternalStorageDirectory();
            File f = rel.isEmpty() ? base : new File(base, rel);
            if (folder ? (f.isDirectory() && f.list() != null) : (f.isFile() && f.canRead())) return f;
        } catch (SecurityException e) {
            Log.i(TAG, "not readable in place: " + rel);
        }
        return null;
    }

    /** The path for a picked file: its real path when readable in place, else the copy made the
     *  last time the same document was picked (when its size still matches), else a new copy in
     *  Incoming/Picked, remembered for next time. */
    private File stagedFile(Uri uri, CopyJob job) throws IOException {
        if (DocumentsContract.isDocumentUri(this, uri)) {
            File real = readableInPlace(uri.getAuthority(), DocumentsContract.getDocumentId(uri), false);
            if (real != null) return real;
        }
        String key = "file:" + uri;
        long size = documentSize(uri);
        String known = storagePrefs().getString(key, null);
        File dest = known != null ? new File(known) : null;
        if (dest != null && !inIncoming(dest)) dest = null;
        if (dest != null && dest.isFile() && size >= 0 && dest.length() == size) return dest;
        if (dest == null) {
            File dir = new File(incoming(), "Picked");
            if (!dir.mkdirs() && !dir.isDirectory()) throw new IOException("can't create " + dir);
            dest = unique(dir, withExtension(safeName(displayName(uri), "photo"), getContentResolver().getType(uri)));
        } else {
            File parent = dest.getParentFile();
            if (parent != null && !parent.mkdirs() && !parent.isDirectory()) throw new IOException("can't create " + parent);
        }
        job.step(dest.getName());
        copy(uri, dest, job);
        storagePrefs().edit().putString(key, dest.getAbsolutePath()).apply();
        return dest;
    }

    /** The folder a picked tree is copied into: the same one as last time for the same tree. */
    private File stagedFolder(Uri tree, String docId) throws IOException {
        String key = "tree:" + tree;
        String known = storagePrefs().getString(key, null);
        File dest = known != null ? new File(known) : null;
        if (dest == null || !inIncoming(dest)) {
            dest = unique(incoming(), safeName(displayName(DocumentsContract.buildDocumentUriUsingTree(tree, docId)), "Folder"));
            storagePrefs().edit().putString(key, dest.getAbsolutePath()).apply();
        }
        if (!dest.mkdirs() && !dest.isDirectory()) throw new IOException("can't create " + dest);
        return dest;
    }

    /** Whether `f` is inside the staging folder (a remembered path is never trusted further). */
    private boolean inIncoming(File f) {
        try {
            String base = incoming().getCanonicalPath() + File.separator;
            return f.getCanonicalPath().startsWith(base);
        } catch (IOException e) {
            return false;
        }
    }

    private long documentSize(Uri uri) {
        try (Cursor c = getContentResolver().query(uri, new String[]{OpenableColumns.SIZE}, null, null, null)) {
            if (c != null && c.moveToFirst() && !c.isNull(0)) return c.getLong(0);
        } catch (Exception e) {
            Log.w(TAG, "size of " + uri + ": " + e);
        }
        return -1;
    }

    /** `name`, with an extension from `mime` when it has none (a provider that names documents
     *  without one), so the app recognises the file. Raw types first: the platform knows few. */
    static String withExtension(String name, String mime) {
        int dot = name.lastIndexOf('.');
        if ((dot > 0 && dot < name.length() - 1) || mime == null) return name;
        String m = mime.toLowerCase(Locale.ROOT);
        String ext;
        switch (m) {
            case "image/x-adobe-dng": case "image/dng": ext = "dng"; break;
            case "image/x-canon-cr2": ext = "cr2"; break;
            case "image/x-canon-cr3": ext = "cr3"; break;
            case "image/x-canon-crw": ext = "crw"; break;
            case "image/x-nikon-nef": ext = "nef"; break;
            case "image/x-nikon-nrw": ext = "nrw"; break;
            case "image/x-sony-arw": ext = "arw"; break;
            case "image/x-fuji-raf": ext = "raf"; break;
            case "image/x-olympus-orf": ext = "orf"; break;
            case "image/x-panasonic-rw2": case "image/x-panasonic-raw": ext = "rw2"; break;
            case "image/x-pentax-pef": ext = "pef"; break;
            case "image/x-samsung-srw": ext = "srw"; break;
            case "image/jpeg": ext = "jpg"; break;
            case "image/heic": case "image/heif": ext = "heic"; break;
            default: ext = MimeTypeMap.getSingleton().getExtensionFromMimeType(m);
        }
        if (ext == null || ext.isEmpty()) return name;
        return (dot == name.length() - 1 ? name.substring(0, dot) : name) + "." + ext;
    }

    /** Whether the app may read every file on shared storage. */
    public boolean hasAllFilesAccess() {
        try {
            if (android.os.Build.VERSION.SDK_INT >= 30) return Environment.isExternalStorageManager();
            return checkSelfPermission(android.Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED;
        } catch (RuntimeException e) {
            Log.w(TAG, "storage access: " + e);
            return false;
        }
    }

    /** Asks for "All files access": the system's page for it on Android 11+, the storage
     *  permission before. */
    public void askAllFilesAccess() {
        runOnUiThread(() -> {
            try {
                if (android.os.Build.VERSION.SDK_INT >= 30) {
                    try {
                        startActivity(new Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION, Uri.parse("package:" + getPackageName())));
                    } catch (RuntimeException e) {
                        // some devices only have the list of apps
                        startActivity(new Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION));
                    }
                } else {
                    requestPermissions(new String[]{android.Manifest.permission.READ_EXTERNAL_STORAGE}, ASK_STORAGE);
                }
            } catch (RuntimeException e) {
                Log.w(TAG, "can't ask for storage access: " + e);
            }
        });
    }

    /** Asks once, on the first start (remembered; Settings > Folders asks again). */
    private void askAllFilesAccessOnce() {
        try {
            SharedPreferences prefs = storagePrefs();
            if (prefs.getBoolean(ASKED_ALL_FILES, false) || hasAllFilesAccess()) return;
            prefs.edit().putBoolean(ASKED_ALL_FILES, true).apply();
            askAllFilesAccess();
        } catch (RuntimeException e) {
            Log.w(TAG, "storage access: " + e);
        }
    }

    /** Opens a web link in the browser. */
    public void openUrl(final String url) {
        runOnUiThread(() -> {
            try {
                Uri uri = Uri.parse(url);
                String scheme = uri.getScheme();
                if (!"https".equals(scheme) && !"http".equals(scheme) && !"mailto".equals(scheme)) {
                    Log.w(TAG, "not opening " + scheme + " link");
                    return;
                }
                startActivity(new Intent(Intent.ACTION_VIEW, uri));
            } catch (Exception e) {
                Log.w(TAG, "open " + url + ": " + e);
            }
        });
    }

    // ---- On-screen keyboard ----
    //
    // NativeActivity's own soft-input handling is unreliable (no input connection, so no
    // composing, predictions or non-Latin text). A 1×1 transparent view over the native content
    // takes focus while the app wants text; its input connection forwards what the keyboard sends
    // to nativeIme, and the app turns it into text and editing keys. It is a plain View, not an
    // EditText: no text of its own, so no system selection handles or cursor.

    /** Keyboard input (registered by crates/android-host; codes decoded by ImeEvent::from_wire). */
    private native void nativeIme(int kind, String text, int a, int b);

    private static final int IME_COMMIT = 0, IME_PREEDIT = 1, IME_FINISH = 2, IME_DELETE = 3, IME_KEY = 4;
    private static final int KEY_BACKSPACE = 0, KEY_ENTER = 1, KEY_DELETE = 2;

    private KeyboardView keyboardView;

    private void addKeyboardView() {
        try {
            keyboardView = new KeyboardView();
            addContentView(keyboardView, new FrameLayout.LayoutParams(1, 1));
        } catch (RuntimeException e) {
            Log.w(TAG, "no keyboard view: " + e);
            keyboardView = null;
        }
    }

    /** Shows the on-screen keyboard (the input view takes focus) or hides it. */
    public void setKeyboard(final boolean show) {
        runOnUiThread(() -> {
            try {
                KeyboardView v = keyboardView;
                InputMethodManager imm = (InputMethodManager) getSystemService(INPUT_METHOD_SERVICE);
                if (v == null || imm == null) return;
                if (show) {
                    v.setFocusable(true);
                    v.setFocusableInTouchMode(true);
                    v.requestFocus();
                    imm.restartInput(v);
                    imm.showSoftInput(v, 0);
                } else {
                    imm.hideSoftInputFromWindow(v.getWindowToken(), 0);
                    v.clearFocus();
                    v.setFocusable(false);
                }
            } catch (RuntimeException e) {
                Log.w(TAG, "keyboard: " + e);
            }
        });
    }

    private void ime(int kind, CharSequence text, int a, int b) {
        try {
            nativeIme(kind, text == null ? null : text.toString(), a, b);
        } catch (Throwable t) {
            Log.e(TAG, "nativeIme: " + t);
        }
    }

    private final class KeyboardView extends View {
        KeyboardView() {
            super(MainActivity.this);
            setBackgroundColor(0);
            setFocusable(false);
        }

        @Override
        public boolean onCheckIsTextEditor() {
            return true;
        }

        @Override
        public InputConnection onCreateInputConnection(EditorInfo info) {
            info.inputType = InputType.TYPE_CLASS_TEXT;
            info.imeOptions = EditorInfo.IME_FLAG_NO_FULLSCREEN | EditorInfo.IME_FLAG_NO_EXTRACT_UI | EditorInfo.IME_ACTION_DONE;
            info.initialSelStart = 0;
            info.initialSelEnd = 0;
            return new KeyboardConnection(this);
        }
    }

    /** Forwards everything to the app and keeps no text: the app's field holds it. */
    private final class KeyboardConnection extends BaseInputConnection {
        KeyboardConnection(View view) {
            super(view, false);
        }

        @Override
        public boolean commitText(CharSequence text, int newCursorPosition) {
            ime(IME_COMMIT, text, 0, 0);
            return true;
        }

        @Override
        public boolean setComposingText(CharSequence text, int newCursorPosition) {
            ime(IME_PREEDIT, text, 0, 0);
            return true;
        }

        @Override
        public boolean finishComposingText() {
            ime(IME_FINISH, null, 0, 0);
            return true;
        }

        @Override
        public boolean deleteSurroundingText(int before, int after) {
            ime(IME_DELETE, null, before, after);
            return true;
        }

        @Override
        public boolean performEditorAction(int action) {
            ime(IME_KEY, null, KEY_ENTER, 0);
            return true;
        }

        @Override
        public boolean sendKeyEvent(KeyEvent event) {
            if (event.getAction() != KeyEvent.ACTION_DOWN) return true;
            switch (event.getKeyCode()) {
                case KeyEvent.KEYCODE_DEL:
                    ime(IME_KEY, null, KEY_BACKSPACE, 0);
                    break;
                case KeyEvent.KEYCODE_FORWARD_DEL:
                    ime(IME_KEY, null, KEY_DELETE, 0);
                    break;
                case KeyEvent.KEYCODE_ENTER:
                case KeyEvent.KEYCODE_NUMPAD_ENTER:
                    ime(IME_KEY, null, KEY_ENTER, 0);
                    break;
                default: {
                    int c = event.getUnicodeChar();
                    if (c > 0) ime(IME_COMMIT, new String(Character.toChars(c)), 0, 0);
                }
            }
            return true;
        }
    }

    // ---- Photos opened or shared from other apps, and dropped from them (AND.6) ----
    //
    // VIEW / SEND / SEND_MULTIPLE intents and drag and drop hand over content:// documents. They are
    // staged like picked files (Incoming/Picked) off the UI thread and the paths go to nativeOpened, which opens the
    // import review. The intent can arrive before the native side has registered nativeOpened, so
    // paths wait in `opened` until hostReady() says it is there.

    /** Paths opened from other apps (registered by crates/android-host). */
    private native void nativeOpened(String[] paths);

    private final List<String> opened = new ArrayList<>();
    private boolean hostReady;

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        receive(intent);
    }

    /** onCreate: the launching intent, and drops from other apps from now on. */
    private void startReceiving(Intent intent) {
        // a recreated activity (after a configuration change) must not import the launching intent twice
        if (intent != null && (intent.getFlags() & Intent.FLAG_ACTIVITY_LAUNCHED_FROM_HISTORY) == 0) receive(intent);
        try {
            getWindow().getDecorView().setOnDragListener((v, event) -> onDrag(event));
        } catch (RuntimeException e) {
            Log.w(TAG, "no drag and drop: " + e);
        }
    }

    /** Part of hostReady(): nativeOpened is registered, hand over what waited. */
    private void openedReady() {
        String[] waiting;
        synchronized (opened) {
            hostReady = true;
            waiting = opened.toArray(new String[0]);
            opened.clear();
        }
        if (waiting.length > 0) deliverOpened(waiting);
    }

    private void receive(Intent intent) {
        final List<Uri> uris = new ArrayList<>();
        try {
            String action = intent.getAction();
            if (Intent.ACTION_VIEW.equals(action)) {
                if (intent.getData() != null) uris.add(intent.getData());
            } else if (Intent.ACTION_SEND.equals(action) || Intent.ACTION_SEND_MULTIPLE.equals(action)) {
                ClipData clip = intent.getClipData();
                if (clip != null) {
                    for (int i = 0; i < clip.getItemCount(); i++) {
                        Uri u = clip.getItemAt(i).getUri();
                        if (u != null) uris.add(u);
                    }
                }
                if (uris.isEmpty()) {
                    if (Intent.ACTION_SEND.equals(action)) {
                        Uri u = intent.getParcelableExtra(Intent.EXTRA_STREAM);
                        if (u != null) uris.add(u);
                    } else {
                        ArrayList<Uri> list = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM);
                        if (list != null) for (Uri u : list) if (u != null) uris.add(u);
                    }
                }
            } else {
                return;
            }
        } catch (RuntimeException e) {
            Log.w(TAG, "shared photos unreadable: " + e);
            toast("Couldn't read the shared photos");
            return;
        }
        // handled once: a later recreation of the activity sees a plain launch
        intent.setAction(Intent.ACTION_MAIN);
        receiveUris(uris, null);
    }

    private boolean onDrag(DragEvent event) {
        switch (event.getAction()) {
            case DragEvent.ACTION_DRAG_STARTED: {
                ClipDescription d = event.getClipDescription();
                return d != null && (d.hasMimeType("image/*") || d.hasMimeType("application/octet-stream"));
            }
            case DragEvent.ACTION_DROP: {
                ClipData clip = event.getClipData();
                if (clip == null) return false;
                DragAndDropPermissions perms = null;
                try {
                    perms = requestDragAndDropPermissions(event);
                } catch (RuntimeException e) {
                    Log.w(TAG, "drop permissions: " + e);
                }
                List<Uri> uris = new ArrayList<>();
                for (int i = 0; i < clip.getItemCount(); i++) {
                    Uri u = clip.getItemAt(i).getUri();
                    if (u != null && ContentResolver.SCHEME_CONTENT.equals(u.getScheme())) uris.add(u);
                }
                receiveUris(uris, perms);
                return !uris.isEmpty();
            }
            default:
                return true;
        }
    }

    /** Stages `uris` like picked files (stagedFile) off the UI thread, then hands the paths over. */
    private void receiveUris(final List<Uri> uris, final DragAndDropPermissions perms) {
        if (uris.isEmpty()) {
            if (perms != null) perms.release();
            return;
        }
        new Thread(() -> {
            List<String> out = new ArrayList<>();
            int failed = 0;
            // the same staging as picked files: real paths where readable, reused copies, progress
            try (CopyJob job = new CopyJob()) {
                job.total = uris.size();
                for (Uri uri : uris) {
                    if (job.cancelled) break;
                    try {
                        out.add(stagedFile(uri, job).getAbsolutePath());
                    } catch (Exception e) {
                        failed++;
                        Log.w(TAG, "copy " + uri + ": " + e);
                    }
                }
            } catch (Exception e) {
                failed = uris.size();
                Log.w(TAG, "shared photos: " + e);
            } finally {
                if (perms != null) {
                    try {
                        perms.release();
                    } catch (RuntimeException e) {
                        Log.w(TAG, "release drop permissions: " + e);
                    }
                }
            }
            if (failed > 0) toast(failed == 1 ? "Couldn't copy 1 shared photo" : "Couldn't copy " + failed + " shared photos");
            if (!out.isEmpty()) deliverOpened(out.toArray(new String[0]));
        }, "shared").start();
    }

    private void deliverOpened(String[] paths) {
        synchronized (opened) {
            if (!hostReady) {
                for (String p : paths) opened.add(p);
                return;
            }
        }
        try {
            nativeOpened(paths);
        } catch (Throwable t) {
            Log.e(TAG, "nativeOpened: " + t);
            toast("Couldn't open the shared photos");
        }
    }

    private void toast(final String text) {
        runOnUiThread(() -> {
            try {
                Toast.makeText(this, text, Toast.LENGTH_LONG).show();
            } catch (RuntimeException e) {
                Log.w(TAG, "toast: " + e);
            }
        });
    }
}
