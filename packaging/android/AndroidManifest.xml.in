<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app (cargo xtask android package; docs/android.md). Version and SDK levels are passed
     to aapt2 by the build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="{{android_package}}">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- peer sync: find other devices over mDNS / DNS-SD on Wi-Fi (multicast lock) (Settings ▸ Sync) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- reading folders on the device in place instead of copying them (docs/android.md, Storage):
         "All files access" on Android 11+, the storage permission before; photos on Android 13+ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <application
        android:label="{{display_name}}"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <!-- the native library NativeActivity loads: lib<name>.so (apps/android) -->
            <meta-data android:name="android.app.lib_name" android:value="app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
